# Assessment Service Environment Variables
# Copy this file to .env and fill in the values

# ─── Server ─────────────────────────────────────────────────────────────────
PORT=6060
NODE_ENV=development

# ─── Database ───────────────────────────────────────────────────────────────
DB_HOST=postgresdb
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_secure_password_here
DB_NAME=assessment_db

# ─── CORS ───────────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:3000
